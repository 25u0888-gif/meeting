{
  "name": "lumina-scheduler-monorepo",
  "version": "1.0.0",
  "description": "Meeting Scheduler Application - Frontend",
  "private": true,
  "scripts": {
    "dev": "cd frontend/lumina-scheduler && npm run dev",
    "build": "npm --prefix ./frontend/lumina-scheduler run build",
    "preview": "npm --prefix ./frontend/lumina-scheduler run preview",
    "lint": "npm --prefix ./frontend/lumina-scheduler run lint",
    "install:all": "npm install && npm --prefix ./frontend/lumina-scheduler install",
    "postinstall": "npm install --prefix ./frontend/lumina-scheduler"
  },
  "keywords": [
    "scheduler",
    "meetings",
    "booking"
  ],
  "author": "",
  "license": "MIT"
}
